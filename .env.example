# Admin connection to the openGauss/GaussDB instance
GAUSSDB_HOST=localhost
GAUSSDB_PORT=5432
GAUSSDB_ADMIN_DB=postgres
GAUSSDB_ADMIN_USER=gaussdb
GAUSSDB_ADMIN_PASSWORD=change-me
GAUSSDB_SSLMODE=disable
GAUSSDB_CONNECT_TIMEOUT=10

# Basic auth for the broker API itself
BROKER_USERNAME=broker
BROKER_PASSWORD=change-me-too

# Where the broker remembers instances/bindings (SQLite)
STATE_DB_PATH=osb-opengauss-state.sqlite3

# Prefix for every database / role / user created by the broker
GAUSSDB_NAME_PREFIX=gdb

# The plan catalog data file (each deployment carries its own copy)
GAUSSDB_PLANS_FILE=plans.toml

# Storage sizing enforcement: role_quota (PERM/TEMP/SPILL SPACE on roles,
# needs workload management) or tablespace (dedicated per-tenant tablespace
# with MAXSIZE hard cap; admin user must be sysadmin)
GAUSSDB_STORAGE_MODE=role_quota

# Curated tablespaces offered as the `tablespace` provision parameter enum
# (role_quota mode only). Leave empty to hide the parameter.
GAUSSDB_TABLESPACES=

# Single path segment under pg_location/ where per-tenant tablespace
# directories are created (tablespace mode only)
GAUSSDB_TABLESPACE_LOCATION_PREFIX=broker

# Platform behaviour: false on Cloud Foundry (sends org/space GUIDs),
# true on Kubernetes Service Catalog
DISABLE_SPACE_ORG_GUID_CHECK=true

# Dev HTTP server bind
BROKER_HOST=127.0.0.1
BROKER_PORT=5000
